<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | Evan.dev</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="page-header">
    <div class="container">
      <h1 class="mb-1">Projects</h1>
      <p class="text-muted mb-0">A selection of things I've built and shipped.</p>
    </div>
  </div>

  <div class="container py-5">

    <!-- Stats row -->
    <div class="row g-3 mb-5">
      <% const active = projects.filter(p => p.status === 'active').length %>
      <% const inProgress = projects.filter(p => p.status === 'in-progress').length %>
      <% const archived = projects.filter(p => p.status === 'archived').length %>
      <div class="col-4 col-md-2">
        <div class="text-center p-3 border rounded-3 bg-light">
          <div class="fw-bold fs-4"><%= projects.length %></div>
          <small class="text-muted">Total</small>
        </div>
      </div>
      <div class="col-4 col-md-2">
        <div class="text-center p-3 border rounded-3 bg-light">
          <div class="fw-bold fs-4 text-success"><%= active %></div>
          <small class="text-muted">Active</small>
        </div>
      </div>
      <div class="col-4 col-md-2">
        <div class="text-center p-3 border rounded-3 bg-light">
          <div class="fw-bold fs-4 text-warning"><%= inProgress %></div>
          <small class="text-muted">In Progress</small>
        </div>
      </div>
    </div>

    <div class="row g-4">
      <% projects.forEach(project => { %>
      <div class="col-sm-6 col-xl-4">
        <div class="project-card card">
          <div class="project-img-placeholder">
            <%
              const icons = {
                'Personal Blog Platform': '📝',
                'Task Manager API': '✅',
                'Weather Dashboard': '⛅',
                'E-Commerce Store': '🛒',
                'CLI Dev Toolkit': '⚙️',
                'Data Visualization Library': '📊'
              };
              const icon = icons[project.title] || '💻';
            %>
            <%= icon %>
          </div>
          <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="card-title mb-0 fw-bold"><%= project.title %></h5>
              <% const statusClass = { active: 'status-active', 'in-progress': 'status-in-progress', archived: 'status-archived' }[project.status] %>
              <span class="status-badge <%= statusClass %> ms-2 flex-shrink-0"><%= project.status %></span>
            </div>
            <p class="card-text text-muted small flex-grow-1"><%= project.description %></p>
            <div class="mb-3">
              <% project.tech.forEach(t => { %>
                <span class="tech-tag"><%= t %></span>
              <% }) %>
            </div>
            <div class="d-flex gap-2">
              <% if (project.github) { %>
              <a href="<%= project.github %>" class="btn btn-sm btn-outline-dark flex-fill">
                <i class="bi bi-github me-1"></i>Code
              </a>
              <% } %>
              <% if (project.demo) { %>
              <a href="<%= project.demo %>" class="btn btn-sm btn-primary flex-fill">
                <i class="bi bi-box-arrow-up-right me-1"></i>Demo
              </a>
              <% } %>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
