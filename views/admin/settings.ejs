<div class="row justify-content-center">
  <div class="col-lg-6">

    <div class="admin-card">
      <div class="d-flex align-items-center gap-2 mb-4">
        <div style="width:2.5rem;height:2.5rem;background:rgba(37,99,235,.1);border-radius:.5rem;display:flex;align-items:center;justify-content:center">
          <i class="bi bi-shield-lock text-primary"></i>
        </div>
        <div>
          <h5 class="fw-bold mb-0">Change Password</h5>
          <small class="text-muted">
            <% if (usingHashedPassword) { %>
              Using a saved password.
            <% } else { %>
              Currently using the default or environment variable password.
            <% } %>
          </small>
        </div>
      </div>

      <form action="/admin/settings/password" method="POST" id="passwordForm">
        <div class="mb-3">
          <label for="currentPassword" class="form-label fw-semibold small">Current Password <span class="text-danger">*</span></label>
          <div class="input-group">
            <input type="password" class="form-control" id="currentPassword" name="currentPassword"
                   required autocomplete="current-password" placeholder="Enter your current password">
            <button class="btn btn-outline-secondary" type="button" onclick="toggleVis('currentPassword', this)" tabindex="-1">
              <i class="bi bi-eye"></i>
            </button>
          </div>
        </div>

        <hr class="my-3">

        <div class="mb-3">
          <label for="newPassword" class="form-label fw-semibold small">New Password <span class="text-danger">*</span></label>
          <div class="input-group">
            <input type="password" class="form-control" id="newPassword" name="newPassword"
                   required minlength="8" autocomplete="new-password" placeholder="At least 8 characters">
            <button class="btn btn-outline-secondary" type="button" onclick="toggleVis('newPassword', this)" tabindex="-1">
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <div class="form-text">Minimum 8 characters.</div>
        </div>

        <div class="mb-4">
          <label for="confirmPassword" class="form-label fw-semibold small">Confirm New Password <span class="text-danger">*</span></label>
          <div class="input-group">
            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword"
                   required minlength="8" autocomplete="new-password" placeholder="Repeat new password">
            <button class="btn btn-outline-secondary" type="button" onclick="toggleVis('confirmPassword', this)" tabindex="-1">
              <i class="bi bi-eye"></i>
            </button>
          </div>
          <div id="matchHint" class="form-text"></div>
        </div>

        <button type="submit" class="btn btn-primary px-4" id="submitBtn">
          <i class="bi bi-check2 me-1"></i>Update Password
        </button>
      </form>
    </div>

    <div class="admin-card mt-4">
      <h6 class="fw-bold mb-1">Admin Username</h6>
      <p class="text-muted small mb-2">
        The username is set via the <code>ADMIN_USER</code> environment variable
        (default: <code>admin</code>). To change it, update the env var and restart the server.
      </p>
    </div>

  </div>
</div>

<script>
function toggleVis(id, btn) {
  const input = document.getElementById(id);
  const isPassword = input.type === 'password';
  input.type = isPassword ? 'text' : 'password';
  btn.querySelector('i').className = isPassword ? 'bi bi-eye-slash' : 'bi bi-eye';
}

// Live match validation
const np = document.getElementById('newPassword');
const cp = document.getElementById('confirmPassword');
const hint = document.getElementById('matchHint');
const btn = document.getElementById('submitBtn');

function checkMatch() {
  if (!cp.value) { hint.textContent = ''; hint.className = 'form-text'; return; }
  const ok = np.value === cp.value;
  hint.textContent = ok ? 'Passwords match.' : 'Passwords do not match.';
  hint.className = ok ? 'form-text text-success' : 'form-text text-danger';
}

np.addEventListener('input', checkMatch);
cp.addEventListener('input', checkMatch);
</script>
