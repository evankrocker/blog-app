<!-- Stat cards -->
<div class="row g-3 mb-4">
  <div class="col-sm-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#2563eb,#1d4ed8)">
      <div class="opacity-75 small mb-1">Total Posts</div>
      <div class="fw-bold" style="font-size:2rem"><%= stats.total %></div>
    </div>
  </div>
  <div class="col-sm-6 col-lg-3">
    <div class="stat-card" style="background:linear-gradient(135deg,#7c3aed,#6d28d9)">
      <div class="opacity-75 small mb-1">Categories</div>
      <div class="fw-bold" style="font-size:2rem"><%= stats.categories %></div>
    </div>
  </div>
</div>

<div class="row g-4">

  <!-- Recent posts -->
  <div class="col-lg-7">
    <div class="admin-card">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="fw-bold mb-0">Recent Posts</h6>
        <a href="/admin/posts/new" class="btn btn-primary btn-sm">
          <i class="bi bi-plus-lg me-1"></i>New Post
        </a>
      </div>
      <% if (recent.length === 0) { %>
        <p class="text-muted small mb-0">No posts yet.</p>
      <% } else { %>
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th>Title</th>
            <th>Category</th>
            <th>Date</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% recent.forEach(post => { %>
          <tr>
            <td class="fw-semibold"><%= post.title %></td>
            <td><span class="badge bg-light text-dark border"><%= post.categoryLabel %></span></td>
            <td class="text-muted small"><%= post.date %></td>
            <td>
              <a href="/admin/posts/<%= post.id %>/edit" class="btn btn-sm btn-outline-secondary py-0">
                <i class="bi bi-pencil"></i>
              </a>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>

  <!-- Category breakdown -->
  <div class="col-lg-5">
    <div class="admin-card">
      <h6 class="fw-bold mb-3">Posts by Category</h6>
      <% if (Object.keys(categoryCounts).length === 0) { %>
        <p class="text-muted small mb-0">No data yet.</p>
      <% } else { %>
        <% const total = Object.values(categoryCounts).reduce((s, c) => s + c, 0) %>
        <% Object.entries(categoryCounts).sort((a,b) => b[1]-a[1]).forEach(([label, count]) => { %>
        <div class="mb-3">
          <div class="d-flex justify-content-between small mb-1">
            <span class="fw-semibold"><%= label %></span>
            <span class="text-muted"><%= count %> post<%= count !== 1 ? 's' : '' %></span>
          </div>
          <div class="progress" style="height:6px">
            <div class="progress-bar" style="width:<%= Math.round(count/total*100) %>%;background:#2563eb"></div>
          </div>
        </div>
        <% }) %>
      <% } %>
    </div>

    <div class="admin-card">
      <h6 class="fw-bold mb-3">Quick Actions</h6>
      <div class="d-grid gap-2">
        <a href="/admin/posts/new" class="btn btn-primary btn-sm">
          <i class="bi bi-plus-circle me-2"></i>Write New Post
        </a>
        <a href="/admin/posts" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-list-ul me-2"></i>Manage All Posts
        </a>
        <a href="/" target="_blank" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-box-arrow-up-right me-2"></i>View Live Blog
        </a>
      </div>
    </div>
  </div>

</div>
