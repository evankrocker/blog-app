<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login | Evan.dev</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    body { background: #f1f5f9; }
    .login-card { max-width: 400px; margin: 10vh auto; }
    .brand { font-weight: 700; font-size: 1.4rem; letter-spacing: -.02em; }
    .brand span { color: #2563eb; }
  </style>
</head>
<body>
  <div class="login-card">
    <div class="text-center mb-4">
      <a href="/" class="text-decoration-none text-dark brand">Evan<span>.</span>dev</a>
      <p class="text-muted small mt-1">Admin Panel</p>
    </div>

    <div class="card border-0 shadow-sm">
      <div class="card-body p-4">
        <h5 class="fw-bold mb-4">Sign In</h5>

        <% if (error && error.type === 'danger') { %>
        <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-circle me-2"></i><%= error.msg %></div>
        <% } %>

        <form action="/admin/login" method="POST">
          <div class="mb-3">
            <label for="username" class="form-label fw-semibold small">Username</label>
            <input type="text" class="form-control" id="username" name="username" required autofocus autocomplete="username">
          </div>
          <div class="mb-4">
            <label for="password" class="form-label fw-semibold small">Password</label>
            <input type="password" class="form-control" id="password" name="password" required autocomplete="current-password">
          </div>
          <button type="submit" class="btn btn-primary w-100">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
          </button>
        </form>
      </div>
    </div>

    <p class="text-center mt-3 small text-muted">
      <a href="/" class="text-muted"><i class="bi bi-arrow-left me-1"></i>Back to blog</a>
    </p>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
