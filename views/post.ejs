<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | Evan.dev</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="post-hero">
    <div class="container">
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
          <li class="breadcrumb-item"><a href="/">Blog</a></li>
          <li class="breadcrumb-item"><a href="/category/<%= post.category %>"><%= post.categoryLabel %></a></li>
          <li class="breadcrumb-item active text-truncate" style="max-width:200px"><%= post.title %></li>
        </ol>
      </nav>
      <a href="/category/<%= post.category %>" class="badge-category mb-3 d-inline-block"><%= post.categoryLabel %></a>
      <h1 class="fw-bold mb-3" style="max-width:780px;letter-spacing:-.03em;line-height:1.2"><%= post.title %></h1>
      <div class="post-meta">
        <i class="bi bi-person"></i> <%= post.author %>
        <span class="separator">&bull;</span>
        <i class="bi bi-calendar3"></i> <%= formatDate(post.date) %>
      </div>
    </div>
  </div>

  <div class="container py-5">
    <div class="row g-4">

      <div class="col-lg-8">
        <div class="post-body">
          <%- post.content %>
        </div>

        <hr class="my-5">

        <div class="d-flex gap-2 flex-wrap">
          <a href="/" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>All Posts
          </a>
          <a href="/category/<%= post.category %>" class="btn btn-outline-primary btn-sm">
            More in <%= post.categoryLabel %>
          </a>
        </div>

        <% if (related.length > 0) { %>
        <div class="mt-5">
          <h4 class="fw-bold mb-4">Related Posts</h4>
          <div class="row g-3">
            <% related.forEach(r => { %>
            <div class="col-sm-6 col-lg-4">
              <div class="post-card card h-100">
                <div class="card-body">
                  <div class="mb-1">
                    <a href="/category/<%= r.category %>" class="badge-category" style="font-size:.7rem"><%= r.categoryLabel %></a>
                  </div>
                  <h5 class="card-title" style="font-size:.95rem">
                    <a href="/post/<%= r.slug %>" class="text-dark fw-bold"><%= r.title %></a>
                  </h5>
                  <p class="card-text small text-muted mb-2" style="-webkit-line-clamp:2;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden"><%= r.excerpt %></p>
                  <small class="text-muted"><i class="bi bi-calendar3 me-1"></i><%= formatDate(r.date) %></small>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>
      </div>

      <!-- Sidebar -->
      <div class="col-lg-4">
        <div class="sidebar-widget">
          <h5>Categories</h5>
          <ul class="category-list">
            <% categories.forEach(cat => { %>
            <li>
              <a href="/category/<%= cat.slug %>" class="<%= cat.slug === post.category ? 'fw-bold text-primary' : '' %>">
                <%= cat.label %>
                <span class="count"><%= cat.count %></span>
              </a>
            </li>
            <% }) %>
          </ul>
        </div>

        <div class="sidebar-widget">
          <h5>Explore</h5>
          <div class="d-grid gap-2">
            <a href="/projects" class="btn btn-sm btn-outline-secondary text-start">
              <i class="bi bi-code-slash me-2"></i>Projects
            </a>
            <a href="/photos" class="btn btn-sm btn-outline-secondary text-start">
              <i class="bi bi-camera me-2"></i>Photos
            </a>
            <a href="/resume" class="btn btn-sm btn-outline-secondary text-start">
              <i class="bi bi-file-person me-2"></i>Resume
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
