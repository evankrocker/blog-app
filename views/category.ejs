<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | Evan.dev</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="page-header">
    <div class="container">
      <nav aria-label="breadcrumb" class="mb-2">
        <ol class="breadcrumb small">
          <li class="breadcrumb-item"><a href="/">Blog</a></li>
          <li class="breadcrumb-item active"><%= categoryLabel %></li>
        </ol>
      </nav>
      <h1 class="mb-1"><%= categoryLabel %></h1>
      <p class="text-muted mb-0"><%= total %> post<%= total !== 1 ? 's' : '' %> in this category</p>
    </div>
  </div>

  <div class="container py-5">
    <div class="row g-4">

      <!-- Posts -->
      <div class="col-lg-8">
        <% posts.forEach(post => { %>
        <div class="post-card card mb-4">
          <div class="card-body">
            <h2 class="card-title h5 mb-2">
              <a href="/post/<%= post.slug %>"><%= post.title %></a>
            </h2>
            <div class="post-meta mb-3">
              <i class="bi bi-person"></i> <%= post.author %>
              <span class="separator">&bull;</span>
              <i class="bi bi-calendar3"></i> <%= formatDate(post.date) %>
            </div>
            <p class="card-text text-muted mb-3"><%= post.excerpt %></p>
            <a href="/post/<%= post.slug %>" class="btn btn-sm btn-outline-primary">
              Read more <i class="bi bi-arrow-right"></i>
            </a>
          </div>
        </div>
        <% }) %>

        <%- include('partials/pagination', { baseUrl: '/category/' + categorySlug, currentPage, totalPages, total }) %>
      </div>

      <!-- Sidebar -->
      <div class="col-lg-4">
        <div class="sidebar-widget">
          <h5>All Categories</h5>
          <ul class="category-list">
            <% categories.forEach(cat => { %>
            <li>
              <a href="/category/<%= cat.slug %>" class="<%= cat.slug === categorySlug ? 'fw-bold text-primary' : '' %>">
                <%= cat.label %>
                <span class="count"><%= cat.count %></span>
              </a>
            </li>
            <% }) %>
          </ul>
        </div>

        <div class="sidebar-widget">
          <h5>Navigation</h5>
          <div class="d-grid gap-2">
            <a href="/" class="btn btn-sm btn-outline-secondary text-start">
              <i class="bi bi-house me-2"></i>All Posts
            </a>
            <a href="/projects" class="btn btn-sm btn-outline-secondary text-start">
              <i class="bi bi-code-slash me-2"></i>Projects
            </a>
            <a href="/photos" class="btn btn-sm btn-outline-secondary text-start">
              <i class="bi bi-camera me-2"></i>Photos
            </a>
            <a href="/resume" class="btn btn-sm btn-outline-secondary text-start">
              <i class="bi bi-file-person me-2"></i>Resume
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
